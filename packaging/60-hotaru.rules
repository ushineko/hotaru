# The cooler's two nodes and the keyboard hotaru draws on, tagged so the
# logged-in user may open them.
#
# hotaru needs no root: systemd-logind puts an ACL on a device tagged
# "uaccess" for whoever is logged in at the seat. Without a rule that applies
# the tag, hotaru finds the cooler and cannot open it -- lighting works,
# telemetry and the screen do not, and the reason is invisible.
#
# On the machine this was written on that rule came from the liquidctl
# package, which hotaru no longer depends on (spec 012). A machine that never
# had liquidctl installed has no such rule, which is exactly the "someone
# else's machine" failure spec 001 exists to prevent.
#
# Two rules because the two interfaces surface differently: the status and
# control channel as a hidraw character device, the screen's bulk endpoint as
# the USB device node itself.
#
# 1e71 is NZXT. The products hotaru drives are in internal/cooler/discover.go;
# the vendor is matched here rather than the product because a rule that
# listed products would have to be edited in step with that table, and a
# uaccess tag on a device hotaru does not drive costs nothing.

KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1e71", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e71", TAG+="uaccess"

# 1038 is SteelSeries: the Apex Pro TKL Wireless Gen 3, whose lighting hotaru
# draws by streaming frames to its hidraw node (spec 060). The rule is
# sanshoku's, from its docs/udev.md, and matches the vendor for the same
# reason as the one above.

KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1038", TAG+="uaccess"

# The rest of what hotaru draws through sanshoku (spec 075), on the same terms
# and from sanshoku's packaging/60-sanshoku.rules: 0b05 ASUS (the Aura
# mainboard controller), 1b1c Corsair (the MM700), 3434 Keychron (VIA's raw
# interface), 046d Logitech (the receivers, over HID++), and the NVIDIA
# driver's I2C adapters, where an MSI graphics card's lighting controller sits
# (which also needs the i2c-dev module loaded).

KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="0b05", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1b1c", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="3434", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEMS=="usb", ATTRS{idVendor}=="046d", TAG+="uaccess"
SUBSYSTEM=="i2c-dev", ATTR{name}=="NVIDIA i2c adapter *", TAG+="uaccess"
