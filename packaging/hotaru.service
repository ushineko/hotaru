[Unit]
Description=hotaru lighting service
Documentation=https://github.com/ushineko/hotaru

# Deliberately no After=, Wants= or Requires= on any OpenRGB unit.
#
# There is no single unit to name: the Arch package ships a system unit, some
# machines run a user one, and other people start the server by hand. Worse,
# ordering would not help. OpenRGB detects devices once, when it starts, and a
# cold boot has been observed reaching "started" with two devices of six
# enumerated -- so "after" is not "ready". hotaru connects with retry and
# judges readiness by the device list instead.
#
# Nothing about graphical-session.target either. The point of remembering what
# the lights were showing is to put it back as soon as the machine is up, and a
# restore that waits for someone to log in has missed the moment it existed for.
# Boot-time start needs `loginctl enable-linger $USER`, which hotaru reports
# and this unit does not do on anyone's behalf.

[Service]
Type=simple
ExecStart=/usr/bin/hotaru serve
Restart=on-failure
RestartSec=5s

# The service needs no privileges beyond the user's own: it speaks to OpenRGB
# over a loopback socket and writes files under the user's XDG directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The three directories are made before the sandbox is built, because they
# cannot be made inside it.
#
# `+` runs this outside the namespacing above -- which is the whole point.
# ProtectHome=read-only makes $HOME read-only to the service, and a path named
# in ReadWritePaths is only punched through if it already exists: systemd
# cannot bind-mount a directory that is not there. So on a fresh install
# hotaru started with all three read-only and could not create them, and the
# first thing anybody did failed:
#
#   hotaru: no image library: make the image directory:
#   mkdir /home/.../.local/share/hotaru: read-only file system
#
# This machine had made them before it was ever packaged, so the fault only
# appeared on the second one. Which is the whole argument of spec 001.
# 0700 rather than whatever the umask says, because this is the mode hotaru
# gives them when it makes them itself, and a picture somebody added for their
# own screen is not a file for the rest of the machine to read.
ExecStartPre=+/usr/bin/install -d -m 0700 %h/.config/hotaru %h/.local/state/hotaru %h/.local/share/hotaru

# Three directories, and they are hotaru's own: the rules and scenes it is
# asked to save, the state it keeps for itself, and the pictures somebody adds
# for the cooler's screen. Everything else under $HOME stays read-only --
# which is how the attempt to edit the desktop's own shortcut file was caught
# (spec 016), and the property is worth more than the convenience.
#
# The dashes stay: a home directory that cannot be written to at all -- an
# account whose $HOME is not there yet, a read-only network mount -- is a
# machine where hotaru should still drive the lights rather than refuse to
# start.
ReadWritePaths=-%h/.config/hotaru -%h/.local/state/hotaru -%h/.local/share/hotaru

# The socket lives in the runtime directory, and ProtectSystem=strict makes
# everything not named here read-only -- including $XDG_RUNTIME_DIR, so without
# this the service cannot create the socket it exists to serve and exits with
# "bind: read-only file system". RuntimeDirectory has systemd create it with
# the right ownership and remove it on stop, which is also one less directory
# hotaru has to make for itself.
RuntimeDirectory=hotaru
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
